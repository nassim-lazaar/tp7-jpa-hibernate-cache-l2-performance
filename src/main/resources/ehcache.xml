<ehcache>
    <defaultCache
            maxEntriesLocalHeap="10000"
            eternal="false"
            timeToIdleSeconds="3600"
            timeToLiveSeconds="3600">
    </defaultCache>

    <cache name="com.example.model.Auteur"
           maxEntriesLocalHeap="1000"
           eternal="false"
           timeToLiveSeconds="3600"/>

    <cache name="com.example.model.Auteur.livres"
           maxEntriesLocalHeap="1000"
           eternal="false"
           timeToLiveSeconds="3600"/>

    <cache name="com.example.model.Livre"
           maxEntriesLocalHeap="1000"
           eternal="false"
           timeToLiveSeconds="3600"/>
</ehcache>
